{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://efc.invalid/schemas/inbox.schema.json",
  "title": "EFC: ожидающее действие (inbox/<key>.json)",
  "type": "object",
  "required": [
    "v",
    "key",
    "why"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "key": {
      "type": "string"
    },
    "why": {
      "type": "string"
    },
    "since": {
      "type": "string",
      "format": "date-time"
    },
    "suggest": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "params": {
            "type": "object"
          },
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "expect": {
            "type": "object",
            "properties": {
              "exit": {
                "type": "integer"
              },
              "output": {
                "type": "string"
              },
              "notOutput": {
                "type": "string"
              },
              "data": {
                "type": "object"
              }
            },
            "additionalProperties": false
          },
          "always": {
            "type": "boolean"
          },
          "onError": {
            "enum": [
              "stop",
              "continue"
            ]
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "ref": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "root": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "abs": {
              "type": "string"
            },
            "kind": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
