      "usage": "help [команда]",
      "readOnly": true
    },
    {
      "name": "build",
      "summary": "Собрать проект",
      "usage": "build [--release]",
      "long": true
    },
    {
      "name": "test",
      "summary": "Запустить тесты",
      "usage": "test [--filter <regex>]",
      "long": true,
      "idempotent": true
    },
    {
      "name": "release",
      "summary": "Выпустить версию (с подтверждением человека)",
      "usage": "release <версия>",
      "long": true
